rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // === Helper Functions ===
    function isAuthenticated() {
      return request.auth != null;
    }

    function isKmuttEmail() {
      return isAuthenticated() &&
             request.auth.token.email != null &&
             request.auth.token.email.matches('.*@mail[.]kmutt[.]ac[.]th');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Timestamp must be within ±60 s of server time — prevents replay attacks
    // and client-supplied future/past timestamps.
    function isRecentTimestamp(ts) {
      return ts >= request.time - duration.value(60, 's') &&
             ts <= request.time + duration.value(60, 's');
    }

    // === Users Collection ===
    match /users/{userId} {
      // ทุกคนที่ login แล้วอ่าน profile ได้ (เพื่อ lookup lineId และดู rating)
      allow read: if isAuthenticated();

      // อนุญาตให้ update เฉพาะ rating/totalReviews/updatedAt เท่านั้น (buyer ส่ง rating ให้ seller)
      // updatedAt ต้องเป็น server timestamp ปัจจุบัน
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['rating', 'totalReviews', 'updatedAt']) &&
        isRecentTimestamp(request.resource.data.updatedAt);

      allow create, delete: if false;
    }

    // === Pending Ratings Collection ===
    match /pendingRatings/{ratingId} {
      // Buyer reads/deletes their own pending ratings (for real-time popup)
      allow read, delete: if isAuthenticated() && resource.data.buyerUid == request.auth.uid;
      // Seller creates or re-sets pending rating — createdAt must be current
      allow create: if isAuthenticated() &&
        request.resource.data.sellerId == request.auth.uid &&
        isRecentTimestamp(request.resource.data.createdAt);
      allow update: if isAuthenticated() &&
        request.resource.data.sellerId == request.auth.uid &&
        isRecentTimestamp(request.resource.data.updatedAt);
    }

    // === Notifications Subcollection ===
    match /users/{userId}/notifications/{notifId} {
      allow read: if isOwner(userId);
      // Any KMUTT user can create — createdAt must be current server time
      allow create: if isKmuttEmail() &&
        isRecentTimestamp(request.resource.data.createdAt);
      // Owner marks as read only
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isOwner(userId);
    }

    // === Devices Subcollection ===
    match /users/{userId}/devices/{deviceId} {
      allow read, write: if isOwner(userId);
    }

    // === Default deny ===
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
