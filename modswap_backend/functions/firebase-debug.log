[debug] [2026-05-31T08:29:59.847Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/modswap-7b425:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\r\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n\r\n    // === Helper Functions ===\r\n    function isAuthenticated() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function isKmuttEmail() {\r\n      return isAuthenticated() &&\r\n             request.auth.token.email != null &&\r\n             request.auth.token.email.matches('.*@mail[.]kmutt[.]ac[.]th');\r\n    }\r\n\r\n    function isOwner(userId) {\r\n      return isAuthenticated() && request.auth.uid == userId;\r\n    }\r\n\r\n    // Timestamp must be within ±60 s of server time — prevents replay attacks\r\n    // and client-supplied future/past timestamps.\r\n    function isRecentTimestamp(ts) {\r\n      return ts >= request.time - duration.value(60, 's') &&\r\n             ts <= request.time + duration.value(60, 's');\r\n    }\r\n\r\n    // === Users Collection ===\r\n    match /users/{userId} {\r\n      // ทุกคนที่ login แล้วอ่าน profile ได้ (เพื่อ lookup lineId และดู rating)\r\n      allow read: if isAuthenticated();\r\n\r\n      // อนุญาตให้ update เฉพาะ rating/totalReviews/updatedAt เท่านั้น (buyer ส่ง rating ให้ seller)\r\n      // updatedAt ต้องเป็น server timestamp ปัจจุบัน\r\n      allow update: if isAuthenticated() &&\r\n        request.resource.data.diff(resource.data).affectedKeys()\r\n          .hasOnly(['rating', 'totalReviews', 'updatedAt']) &&\r\n        isRecentTimestamp(request.resource.data.updatedAt);\r\n\r\n      allow create, delete: if false;\r\n    }\r\n\r\n    // === Pending Ratings Collection ===\r\n    match /pendingRatings/{ratingId} {\r\n      // Buyer reads/deletes their own pending ratings (for real-time popup)\r\n      allow read, delete: if isAuthenticated() && resource.data.buyerUid == request.auth.uid;\r\n      // Seller creates or re-sets pending rating — createdAt must be current\r\n      allow create: if isAuthenticated() &&\r\n        request.resource.data.sellerId == request.auth.uid &&\r\n        isRecentTimestamp(request.resource.data.createdAt);\r\n      allow update: if isAuthenticated() &&\r\n        request.resource.data.sellerId == request.auth.uid &&\r\n        isRecentTimestamp(request.resource.data.updatedAt);\r\n    }\r\n\r\n    // === Notifications Subcollection ===\r\n    match /users/{userId}/notifications/{notifId} {\r\n      allow read: if isOwner(userId);\r\n      // Any KMUTT user can create — createdAt must be current server time\r\n      allow create: if isKmuttEmail() &&\r\n        isRecentTimestamp(request.resource.data.createdAt);\r\n      // Owner marks as read only\r\n      allow update: if isOwner(userId) &&\r\n        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);\r\n      allow delete: if isOwner(userId);\r\n    }\r\n\r\n    // === Devices Subcollection ===\r\n    match /users/{userId}/devices/{deviceId} {\r\n      allow read, write: if isOwner(userId);\r\n    }\r\n\r\n    // === Default deny ===\r\n    match /{document=**} {\r\n      allow read, write: if false;\r\n    }\r\n  }\r\n}\r\n"}]}}
